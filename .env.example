# Copiar como .env y ajustar. El archivo .env no se sube al repositorio.

# Genera una con: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=cambia-esta-clave

# Ruta relativa a la raíz del proyecto
UPLOAD_FOLDER=app/static/uploads

# Tamaño máximo de cada solicitud en bytes (20 MB, dos fotos de hasta 10 MB)
MAX_CONTENT_LENGTH=20971520

DEPRATI_BASE_URL=https://www.deprati.com.ec

# 1 activa el modo depuración de Flask, solo en desarrollo
FLASK_DEBUG=1
